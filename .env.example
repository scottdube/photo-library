# photo-library configuration template
# Copy to .env and fill in actual values. Do not commit .env.

# Path to the Apple Photos library
# Default macOS location: ~/Pictures/Photos Library.photoslibrary
PHOTOS_LIBRARY_PATH=/Users/scottdube/Pictures/Photos Library.photoslibrary

# Where the SQLite vector index lives
# Single file, gitignored, large
INDEX_DB_PATH=/Users/scottdube/photo-library-data/index.db

# Where thumbnail cache lives (if we generate thumbnails separately)
THUMBNAIL_CACHE_DIR=/Users/scottdube/photo-library-data/thumbnails

# CLIP model selection (resolved during Phase 0)
# Examples: "openai/clip-vit-base-patch32", "google/siglip-base-patch16-224"
CLIP_MODEL_NAME=

# Query service config
QUERY_SERVICE_HOST=0.0.0.0
QUERY_SERVICE_PORT=8081

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
