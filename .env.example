# photo-library configuration template
# Copy to .env and fill in actual values. Do not commit .env.

# Path to the Apple Photos library
# Lives on the external 4TB SSD since 2026-04-27; this is the System Photo
# Library. The pre-migration internal copy was deleted 2026-08-16 — do not
# repoint this at ~/Pictures. Quoted because the path contains a space.
PHOTOS_LIBRARY_PATH="/Volumes/4TB_Removable/Photos/Photos Library.photoslibrary"

# Phase 1 project artifacts live on the external volume, segregated from the
# Apple-managed library bundle per the 2026-04-27 decision.
# Do not place these on the Mac Mini internal disk.

# Where the SQLite vector index lives
# Single file, gitignored, large
INDEX_DB_PATH=/Volumes/4TB_Removable/photo-library/index.db

# Where thumbnail cache lives (if we generate thumbnails separately)
THUMBNAIL_CACHE_DIR=/Volumes/4TB_Removable/photo-library/thumbnails

# CLIP model selection (resolved during Phase 0)
# Examples: "openai/clip-vit-base-patch32", "google/siglip-base-patch16-224"
CLIP_MODEL_NAME=

# Query service config
QUERY_SERVICE_HOST=0.0.0.0
QUERY_SERVICE_PORT=8081

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
